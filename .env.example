# VORLAGE — HIER STEHT NIE EIN ECHTER SCHLUESSEL.
#
# Der echte Schluessel liegt in den Netlify-Umgebungsvariablen
# (Project configuration -> Environment variables) und wird von
# netlify/functions/anfrage.js zur Laufzeit ueber process.env gelesen.
# Eine .env im Repository waere dort wirkungslos: Netlify liest sie nicht.
#
# Diese Datei dokumentiert nur, WELCHE Variablen gesetzt sein muessen.
# Fuer oertliches Ausprobieren mit `netlify dev` eine echte .env daneben
# legen — die ist durch .gitignore ausgeschlossen.

# Der API-Schluessel aus resend.com -> API Keys. Beginnt mit "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Empfaenger der Anfragen. Ohne diese Angabe faellt die Funktion auf
# info@estera.immobilien zurueck.
ANFRAGE_EMPFAENGER=info@estera.immobilien

# Absenderadresse. MUSS zu einer bei Resend verifizierten Domain gehoeren,
# sonst lehnt Resend den Versand ab.
ANFRAGE_ABSENDER=formular@estera.immobilien
