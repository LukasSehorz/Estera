.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

node_modules/
*.log

# Geheimnisse gehoeren NICHT ins Repository. Dieses Repo ist oeffentlich
# (Netlify: "Public"), ein hier eingecheckter Resend-Schluessel waere binnen
# Stunden abgegriffen und wuerde ueber die Domain Spam versenden.
# Der Schluessel liegt in den Netlify-Umgebungsvariablen und wird von der
# Funktion zur Laufzeit ueber process.env gelesen — eine .env im Repo waere
# dort ohnehin wirkungslos.
.env
.env.*
!.env.example

# Rohmaterial der Videos — Ausgangsdateien des Kunden, nicht die
# ausgelieferten Fassungen. Sie liegen im Ordner Bilder/ und werden nur zum
# Neurendern gebraucht; zusammen rund 31 MB, die das Repository unnoetig
# aufblaehen. Die fertigen Videos unter assets/video/ sind versioniert.
Bilder/*.mov
Bilder/b28f8eb9*.mp4

# Die drei Rohfassungen des Karriere-Videos aus kie.ai, zusammen rund 60 MB.
# Gewaehlt wurde B; sie liegt geschnitten unter assets/video/kar-hero.*.
# Die Rohfassungen bleiben nur oertlich liegen, falls doch A oder C gewuenscht wird.
Bilder/video-entwuerfe/

# Die unbeschnittenen Ausgangsbilder der beiden Laufbaender, 27 MB.
# Sie sind aus Briefing/bildauftraege-baender.json jederzeit neu erzeugbar;
# ausgeliefert werden ohnehin nur die beschnittenen webp/jpg daneben.
assets/img/karriere/band/.original/
